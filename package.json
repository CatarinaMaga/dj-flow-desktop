{
  "name": "dj-flow-desktop",
  "version": "1.2.0",
  "description": "DJ Flow - app para DJs que usam Rekordbox: detector de qualidade real das músicas (320 kbps de verdade) e Cofre organizado.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "npm run build"
  },
  "author": "Catarina Magalhães",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "youtube-dl-exec": "^3.0.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.djflow.desktop",
    "productName": "DJ Flow",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/youtube-dl-exec/bin/yt-dlp.exe",
        "to": "app/node_modules/youtube-dl-exec/bin/yt-dlp.exe"
      }
    ]
  }
}
